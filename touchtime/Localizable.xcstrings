    "Allow alarm access in Settings to get countdown reminders as alarms." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カウントダウンのリマインダーをアラームで受け取るには、“設定”でアラームへのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카운트다운 미리 알림을 알람으로 받으려면 설정 앱에서 알람 접근을 허용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中允许闹钟权限，以闹钟形式接收倒计时提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」中允許鬧鐘權限，以鬧鐘形式接收倒數計時提醒。"
          }
        }
      }
    },
