    "In %@, the event is in %d days." : {
      "comment" : "Countdown reminder notification when the reminder time is set on another city's clock; the placeholders are the city name and the number of days until the event there.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %1$@, the event is in %2$d days."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@時間では、イベントまであと%2$d日です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 시간 기준, 이벤트까지 %2$d일 남았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@时间，距离事件还有 %2$d 天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@時間，距離事件還有 %2$d 天。"
          }
        }
      }
    },
    "In %@, the event is today." : {
